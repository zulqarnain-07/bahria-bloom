{
  "manifest_version": 3,
  "name": "Bahria Bloom",
  "version": "1.0.0",
  "description": "A blossom-pink redesign of the Bahria University CMS: portal page, sign-in pages and dashboard, with falling petals and click bursts.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://cms.bahria.edu.pk/*"],
      "css": ["theme.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cms.bahria.edu.pk/*"],
      "js": ["blossom.js", "content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://cms.bahria.edu.pk/*"],
      "js": ["chart-theme.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
